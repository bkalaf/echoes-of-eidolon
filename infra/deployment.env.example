# Install as /etc/eidolon/deployment.env with mode 0600.
DATABASE_URL=postgresql://eidolon:replace-me@127.0.0.1:5432/echoes_of_eidolon
POSTGRES_DB=echoes_of_eidolon
POSTGRES_PASSWORD=replace-me
POSTGRES_USER=eidolon
EIDOLON_BACKUP_DIR=/var/backups/eidolon
EIDOLON_COMPOSE_FILE=/srv/eidolon/current/compose.yaml
EIDOLON_DEPLOYMENT_LOCK_FILE=/run/lock/eidolon-deployment.lock
EIDOLON_DEPLOYMENT_RECORD_FILE=/var/lib/eidolon/deployments.log
EIDOLON_HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
EIDOLON_ATLAS_RELEASE_ROOT=/srv/eidolon/current/EIDOLON_ATLAS_DATASET_R09_AUTHORITATIVE_DEPLOYMENT_V2
EIDOLON_REPOSITORY_DIR=/srv/eidolon/current
EIDOLON_SYSTEMD_SERVICE=eidolon-web.service

{
  "name": "@echoes/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-with-local-secrets.mjs vite dev",
    "start": "node scripts/run-with-local-secrets.mjs node .output/server/index.mjs",
    "db:migrate": "node scripts/run-with-local-secrets.mjs pnpm exec prisma migrate deploy",
    "db:up": "node scripts/run-with-local-secrets.mjs docker compose -f ../../compose.yaml up -d --wait",
    "db:down": "node scripts/run-with-local-secrets.mjs docker compose -f ../../compose.yaml stop postgres",
    "db:verify-migrations": "node scripts/run-with-local-secrets.mjs pnpm exec tsx scripts/verify-migrations.mts",
    "generate": "prisma generate",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@better-auth/passkey": "1.6.25",
    "@better-auth/prisma-adapter": "1.6.25",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-start": "^1.168.42",
    "@tanstack/react-table": "^9.1.2",
    "ajv": "^8.20.0",
    "better-auth": "1.6.25",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.18.1",
    "stripe": "^22.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

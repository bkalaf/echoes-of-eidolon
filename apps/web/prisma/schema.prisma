enum AuthorizationRole {
  user
  member
  admin
  owner
}

model User {
  id                  String                    @id
  name                String
  username            String?                   @unique
  displayUsername     String?
  email               String                    @unique
  emailVerified       Boolean                   @default(false)
  image               String?
  eligibilityStatus   AgeEligibility
  betaEligible        Boolean                   @default(false)
  role                AuthorizationRole         @default(user)
  banned              Boolean                   @default(false)
  banReason           String?
  banExpires          DateTime?
  twoFactorEnabled    Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            Session[]
  accounts            Account[]
  passkeys            Passkey[]
  memberships         Member[]
  sentInvitations     Invitation[]              @relation("InvitationInviter")
  betaInviteRequests  BetaInviteRequest[]       @relation("BetaInviteRequester")
  consumedBetaInvites BetaInvitationCode[]      @relation("BetaInviteConsumer")
  twoFactors          TwoFactor[]
  capabilityEvents    CapabilityEvent[]
  puzzleAcceptances   PuzzleChallengeAccepted[]
  membershipGrants    MembershipGrant[]
  orders              Order[]
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime
  members     Member[]
  invitations Invitation[]
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model BetaInviteRequest {
  id          String                        @id
  requesterId String
  friendName  String
  email       String
  reason      String
  status      FriendInvitationRequestStatus @default(PENDING)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  requester   User                          @relation("BetaInviteRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  invitation  BetaInvitationCode?

  @@index([requesterId])
  @@index([status])
}

model BetaInvitationCode {
  id               String            @id
  requestId        String            @unique
  recipientEmail   String
  codeHash         String            @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  consumedAt       DateTime?
  consumedByUserId String?
  createdAt        DateTime          @default(now())
  request          BetaInviteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  consumedBy       User?             @relation("BetaInviteConsumer", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([recipientEmail])
  @@index([expiresAt])
  @@index([consumedByUserId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([credentialID])
  @@index([userId])
}

model Species {
  speciesId            String      @id
  name                 String
  speciesKind          SpeciesKind
  scientificName       String?
  taxonomy             Json?
  appearance           String[]
  anthropomorphization String[]
  breeds               Breed[]
}

model Breed {
  breedId              String                      @id
  name                 String
  speciesId            String
  cultureId            String?
  appearance           String[]
  accent               String[]
  costume              String[]
  architecture         String[]
  structuralStability  Float?
  motivation           Motivation?
  operatingStyle       OperatingStyle?
  structureOrientation StructureOrientation?
  administrationMode   AdministrationMode?
  ownershipMode        OwnershipMode?
  allocationMode       AllocationMode?
  legitimacyBasis      LegitimacyBasis?
  authoritySource      AuthoritySource?
  politicalForm        PoliticalForm?
  economicForm         EconomicForm?
  species              Species                     @relation(fields: [speciesId], references: [speciesId], onDelete: Restrict)
  culture              Culture?                    @relation(fields: [cultureId], references: [cultureId], onDelete: Restrict)
  characters           Character[]
  populationEvents     SettlementPopulationEvent[]
  dominantInWorlds     SettlementWorld[]           @relation("SettlementWorldDominantBreed")

  @@index([speciesId])
  @@index([cultureId])
}

model Culture {
  cultureId                String            @id
  culturePoolId            CulturePoolId
  cultureName              String
  hamletArchitecture       String
  villageArchitecture      String
  townArchitecture         String
  cityArchitecture         String
  metropolisArchitecture   String
  architectureColorPalette String[]
  clothingPalette          String[]
  clothing                 String
  breeds                   Breed[]
  settlementWorlds         SettlementWorld[]
}

model Character {
  characterId String       @id
  displayName String
  breedId     String
  breed       Breed        @relation(fields: [breedId], references: [breedId], onDelete: Restrict)
  protagonist Protagonist?
  antagonist  Antagonist?

  @@index([breedId])
}

model Protagonist {
  protagonistId String                @id
  characterId   String                @unique
  importance    ProtagonistImportance
  worldKey      WorldKey?
  character     Character             @relation(fields: [characterId], references: [characterId], onDelete: Cascade)
  concordFor    Companion[]           @relation("CompanionConcordProtagonist")
  ruinFor       Companion[]           @relation("CompanionRuinProtagonist")
  schismFor     Companion[]           @relation("CompanionSchismProtagonist")

  @@index([characterId])
}

model Architect {
  architectId  String       @id
  departmentId String
  name         String
  profession   String?
  antagonists  Antagonist[]
}

model Antagonist {
  antagonistId          String          @id
  characterId           String          @unique
  worldKey              WorldKey?
  family                String
  trueFlawName          String
  witnessName           String
  presentsAs            String
  inversionRule         String
  architectId           String
  apparentDomain        String
  realDomain            String
  color                 Json
  legendaryRewardId     String
  puzzleBlueprintId     String
  constellationBeforeId String?
  constellationAfterId  String?
  character             Character       @relation(fields: [characterId], references: [characterId], onDelete: Cascade)
  architect             Architect       @relation(fields: [architectId], references: [architectId], onDelete: Restrict)
  legendaryReward       LegendaryReward @relation(fields: [legendaryRewardId], references: [legendaryRewardId], onDelete: Restrict)
  puzzleBlueprint       PuzzleBlueprint @relation(fields: [puzzleBlueprintId], references: [puzzleBlueprintId], onDelete: Restrict)
  constellationBefore   Constellation?  @relation("AntagonistConstellationBefore", fields: [constellationBeforeId], references: [constellationId], onDelete: SetNull)
  constellationAfter    Constellation?  @relation("AntagonistConstellationAfter", fields: [constellationAfterId], references: [constellationId], onDelete: SetNull)
  primaryForWitnesses   Witness[]       @relation("WitnessAntagonist1")
  secondaryForWitnesses Witness[]       @relation("WitnessAntagonist2")

  @@index([characterId])
  @@index([architectId])
  @@index([legendaryRewardId])
  @@index([puzzleBlueprintId])
}

model Witness {
  witnessId     String      @id
  antagonist1Id String
  antagonist2Id String?
  antagonist1   Antagonist  @relation("WitnessAntagonist1", fields: [antagonist1Id], references: [antagonistId], onDelete: Restrict)
  antagonist2   Antagonist? @relation("WitnessAntagonist2", fields: [antagonist2Id], references: [antagonistId], onDelete: Restrict)

  @@index([antagonist1Id])
  @@index([antagonist2Id])
}

model Soul {
  soulId     String      @id
  name       String
  companions Companion[]
}

model Companion {
  companionKey         CompanionKey @id
  concordProtagonistId String
  ruinProtagonistId    String
  schismProtagonistId  String
  soulId               String
  heirloom             Heirloom
  concordProtagonist   Protagonist  @relation("CompanionConcordProtagonist", fields: [concordProtagonistId], references: [protagonistId], onDelete: Restrict)
  ruinProtagonist      Protagonist  @relation("CompanionRuinProtagonist", fields: [ruinProtagonistId], references: [protagonistId], onDelete: Restrict)
  schismProtagonist    Protagonist  @relation("CompanionSchismProtagonist", fields: [schismProtagonistId], references: [protagonistId], onDelete: Restrict)
  soul                 Soul         @relation(fields: [soulId], references: [soulId], onDelete: Restrict)

  @@index([concordProtagonistId])
  @@index([ruinProtagonistId])
  @@index([schismProtagonistId])
  @@index([soulId])
}

model TimelineEvent {
  timelineEventId   String            @id
  name              String
  timelineEventType TimelineEventType
  summary           String
}

model Interlude {
  interludeId       String                  @id
  name              String
  interludeType     InterludeType

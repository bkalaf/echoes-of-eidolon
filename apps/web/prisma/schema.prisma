  @@index([citationId])
}

model KnowledgeBaseItem {
  knowledgeBaseItemId String                      @id
  entityType          EntityType
  entityId            String
  title               String
  baseContent         String
  citations           KnowledgeBaseItemCitation[]
  blocks              KnowledgeBaseBlock[]
  disclosures         KnowledgeBaseDisclosure[]

  @@index([entityType, entityId])
}

model KnowledgeBaseBlock {
  knowledgeBaseBlockId String                    @id
  knowledgeBaseItemId  String
  ordinal              Int
  kind                 KnowledgeBaseBlockKind
  content              String
  knowledgeBaseItem    KnowledgeBaseItem         @relation(fields: [knowledgeBaseItemId], references: [knowledgeBaseItemId], onDelete: Cascade)
  anchoredDisclosures  KnowledgeBaseDisclosure[]

  @@unique([knowledgeBaseItemId, ordinal])
}

model KnowledgeBaseDisclosure {
  knowledgeBaseDisclosureId String                            @id
  knowledgeBaseItemId       String
  capabilityDefinitionId    String
  ordinal                   Int
  operator                  CapabilityRequirementOperator
  requiredBoolean           Boolean?
  requiredNumber            Float?
  requiredToken             String?
  mode                      KnowledgeBaseDisclosureMode
  anchorBlockId             String?
  knowledgeBaseItem         KnowledgeBaseItem                 @relation(fields: [knowledgeBaseItemId], references: [knowledgeBaseItemId], onDelete: Cascade)
  capabilityDefinition      CapabilityDefinition              @relation(fields: [capabilityDefinitionId], references: [capabilityDefinitionId], onDelete: Restrict)
  anchorBlock               KnowledgeBaseBlock?               @relation(fields: [anchorBlockId], references: [knowledgeBaseBlockId], onDelete: Restrict)
  blocks                    KnowledgeBaseDisclosureBlock[]
  citations                 KnowledgeBaseDisclosureCitation[]

  @@unique([knowledgeBaseItemId, ordinal])
  @@index([capabilityDefinitionId])
  @@index([anchorBlockId])
}

model KnowledgeBaseDisclosureBlock {
  knowledgeBaseDisclosureBlockId String                  @id
  knowledgeBaseDisclosureId      String
  ordinal                        Int
  kind                           KnowledgeBaseBlockKind
  content                        String
  disclosure                     KnowledgeBaseDisclosure @relation(fields: [knowledgeBaseDisclosureId], references: [knowledgeBaseDisclosureId], onDelete: Cascade)

  @@unique([knowledgeBaseDisclosureId, ordinal], map: "KBDisclosureBlock_disclosure_ordinal_key")
}

model KnowledgeBaseDisclosureCitation {
  knowledgeBaseDisclosureId String
  citationId                String
  firstUseOrder             Int
  disclosure                KnowledgeBaseDisclosure @relation(fields: [knowledgeBaseDisclosureId], references: [knowledgeBaseDisclosureId], onDelete: Cascade)
  citation                  Citation                @relation(fields: [citationId], references: [citationId], onDelete: Restrict)

  @@id([knowledgeBaseDisclosureId, citationId])
  @@unique([knowledgeBaseDisclosureId, firstUseOrder], map: "KBDisclosureCitation_disclosure_order_key")
  @@index([citationId])
}

model KnowledgeBaseItemCitation {
  knowledgeBaseItemId String
  citationId          String
  firstUseOrder       Int
  knowledgeBaseItem   KnowledgeBaseItem @relation(fields: [knowledgeBaseItemId], references: [knowledgeBaseItemId], onDelete: Cascade)
  citation            Citation          @relation(fields: [citationId], references: [citationId], onDelete: Restrict)

  @@id([knowledgeBaseItemId, citationId])
  @@unique([knowledgeBaseItemId, firstUseOrder])
  @@index([citationId])
}


  template          String
  puzzleVersion     PuzzleBlueprintVersion @relation(fields: [puzzleBlueprintId, generatorVersion], references: [puzzleBlueprintId, generatorVersion], onDelete: Cascade, map: "PuzzleHintTemplate_version_fkey")

  @@id([puzzleBlueprintId, generatorVersion, level])
}

model PuzzleChallengeAccepted {
  puzzleChallengeAcceptedId String                 @id
  userId                    String
  puzzleBlueprintId         String
  generatorVersion          Int
  acceptedAt                DateTime               @default(now())
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleVersion             PuzzleBlueprintVersion @relation(fields: [puzzleBlueprintId, generatorVersion], references: [puzzleBlueprintId, generatorVersion], onDelete: Restrict, map: "PuzzleChallengeAccepted_version_fkey")

  @@index([userId])
  @@index([puzzleBlueprintId, generatorVersion], map: "PuzzleChallengeAccepted_version_idx")
}

  substitutionsTo   InterludeSubstitution[] @relation("InterludeSubstitutionReplacement")
}

model InterludeSubstitution {
  interludeSubstitutionId String    @id
  interludeId             String
  replacementInterludeId  String
  reason                  String
  interlude               Interlude @relation("InterludeSubstitutionSource", fields: [interludeId], references: [interludeId], onDelete: Cascade)
  replacementInterlude    Interlude @relation("InterludeSubstitutionReplacement", fields: [replacementInterludeId], references: [interludeId], onDelete: Restrict)

  @@index([interludeId])
  @@index([replacementInterludeId])
}

model Pillar {

  worldInstanceId   String             @id
  worldKey          WorldKey
  currentGameMinute BigInt             @default(0)
  createdAt         DateTime           @default(now())
  parties           Party[]
  moneyTransactions MoneyTransaction[]
  gameSessions      GameSession[]
}

model Party {
  partyId           String             @id
  userId            String
  worldInstanceId   String
  withdrawalLimit   Int?
  createdAt         DateTime           @default(now())
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  worldInstance     WorldInstance      @relation(fields: [worldInstanceId], references: [worldInstanceId], onDelete: Restrict)
  members           PartyMember[]
  moneyTransactions MoneyTransaction[]
  gameSessions      GameSession[]

  @@index([userId])
  @@index([worldInstanceId])
}

model PartyMember {
  partyId           String
  characterId       String
  rest              Float?
  morale            Float?
  comfort           Float?
  conditionSentence String?
  party             Party     @relation(fields: [partyId], references: [partyId], onDelete: Cascade)
  companion         Companion @relation(fields: [characterId], references: [characterId], onDelete: Restrict)

  @@id([partyId, characterId])
}

model RecoveryPolicy {
  recoveryPolicyId String   @id
  name             String
  configuration    Json
  active           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MoneyTransaction {
  moneyTransactionId   String        @id
  partyId              String
  worldInstanceId      String
  delta                Int
  withdrawalAmount     Int?
  occurredAtGameMinute BigInt
  context              Json
  recordedAt           DateTime      @default(now())
  party                Party         @relation(fields: [partyId], references: [partyId], onDelete: Restrict)
  worldInstance        WorldInstance @relation(fields: [worldInstanceId], references: [worldInstanceId], onDelete: Restrict)

  @@index([partyId, worldInstanceId, occurredAtGameMinute], map: "MoneyTransaction_partyId_worldInstanceId_occurredAtGameMinute_i")
  @@index([recordedAt])
}

model GameTurn {
  gameTurnId        String         @id
  gameSessionId     String
  sequence          Int
  inputText         String
  responseText      String?
  status            GameTurnStatus @default(RECEIVED)
  providerReference String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  gameSession       GameSession    @relation(fields: [gameSessionId], references: [gameSessionId], onDelete: Cascade)

  @@unique([gameSessionId, sequence])
}

model City {
  cityId            String          @id
  settlementWorldId String
  name              String
  geometryVersion   Int             @default(1)
  settlementWorld   SettlementWorld @relation(fields: [settlementWorldId], references: [settlementWorldId], onDelete: Cascade)
  parcels           Parcel[]
  streets           Street[]
  buildings         Building[]

  @@unique([settlementWorldId])
}

model Parcel {
  parcelId String @id
  cityId   String
  geometry Json
  city     City   @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@index([cityId])
}

model Street {
  streetId String @id
  cityId   String
  geometry Json
  city     City   @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@index([cityId])
}

model Building {
  buildingId String  @id
  cityId     String
  parcelId   String?
  geometry   Json
  city       City    @relation(fields: [cityId], references: [cityId], onDelete: Cascade)

  @@index([cityId])
}

model Campaign {
  campaignId String              @id
  worldKey   WorldKey
  name       String
  placements CampaignPlacement[]

  @@unique([worldKey])
}

model CampaignPlacement {
  campaignPlacementId String             @id
  campaignId          String
  objectType          CampaignObjectType
  objectId            String
  bookNumbers         Int[]
  ordinal             Int
  campaign            Campaign           @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)

  @@unique([campaignId, objectType, objectId])
  @@unique([campaignId, ordinal])
}

model BookGroupingDefinition {
  bookGroupingDefinitionId String                  @id
  groupingType             BookGroupingType        @unique
  editability              BookGroupingEditability
  values                   BookGroupingValue[]
}

model BookGroupingValue {
  bookGroupingValueId      String                 @id
  bookGroupingDefinitionId String
  worldKey                 WorldKey
  logicalKey               String
  bookNumbers              Int[]
  valueRefType             EntityType?
  valueRefId               String?
  ordinal                  Int
  definition               BookGroupingDefinition @relation(fields: [bookGroupingDefinitionId], references: [bookGroupingDefinitionId], onDelete: Restrict)

  @@unique([bookGroupingDefinitionId, worldKey, logicalKey], map: "BookGroupingValue_definition_world_logical_key")
  @@unique([bookGroupingDefinitionId, worldKey, ordinal], map: "BookGroupingValue_definition_world_ordinal_key")
  @@index([worldKey, ordinal])
}

model CalendarOrdinal {
  calendarOrdinalId String @id
  ordinalDay        Int    @unique
  monthNumber       Int
  dayOfMonth        Int
  weekdayName       String
  monthName         String
}
